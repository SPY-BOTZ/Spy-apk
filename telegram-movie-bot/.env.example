# Telegram API Credentials (from https://my.telegram.org)
API_ID=12345678
API_HASH=your_telegram_api_hash

# Bot Token (from @BotFather)
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Super-Admin Telegram Numeric User ID (from @userinfobot)
OWNER_ID=123456789

# Private/Public Storage Channel ID (bot must be admin in this channel, e.g. -1001234567890)
STORAGE_CHANNEL_ID=-1001234567890

# TMDB API v3 Key (from https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your_tmdb_api_v3_key

# Firebase Realtime Database URL & Database Secret
FIREBASE_DB_URL=https://your-project-id-default-rtdb.firebaseio.com
FIREBASE_DATABASE_SECRET=your_firebase_database_secret

# HTTP Server Port (Koyeb injects PORT automatically, defaults to 8000)
PORT=8000

# Optional: Public HTTPS base URL for generated watch/download links (e.g. https://your-app.koyeb.app)
# If omitted, Koyeb's KOYEB_PUBLIC_DOMAIN is used automatically when available.
BASE_URL=

# Optional: Fallback poster image URL if TMDB has no poster
FALLBACK_POSTER_URL=https://placehold.co/500x750/0f172a/f8fafc.png?text=No+Poster
